{
  "ai_gateway": {
    "port": 8081,
    "host": "0.0.0.0",
    "log_level": "info"
  },
  "models": {
    "openai": {
      "api_key": "",
      "base_url": "https://api.openai.com/v1",
      "available": [
        {"id": "gpt-4o", "name": "GPT-4o"},
        {"id": "gpt-4o-mini", "name": "GPT-4o Mini"},
        {"id": "gpt-3.5-turbo", "name": "GPT-3.5 Turbo"}
      ]
    },
    "anthropic": {
      "api_key": "",
      "base_url": "https://api.anthropic.com",
      "available": [
        {"id": "claude-3-5-sonnet-20241022", "name": "Claude 3.5 Sonnet"},
        {"id": "claude-3-haiku-20240307", "name": "Claude 3 Haiku"}
      ]
    },
    "deepseek": {
      "api_key": "",
      "base_url": "https://api.deepseek.com",
      "available": [
        {"id": "deepseek-chat", "name": "DeepSeek Chat"},
        {"id": "deepseek-reasoner", "name": "DeepSeek Reasoner"}
      ]
    },
    "local": {
      "api_key": "",
      "base_url": "http://localhost:11434/v1",
      "available": [
        {"id": "llama3.2", "name": "Llama 3.2 (Local)"},
        {"id": "qwen2.5:7b", "name": "Qwen 2.5 7B (Local)"}
      ]
    }
  },
  "routing": {
    "default_model": "gpt-4o",
    "fallback_model": "local/llama3.2",
    "routes": {
      "system_completion": "claude-3-5-sonnet-20241022",
      "fast_response": "gpt-4o-mini",
      "reasoning": "deepseek-reasoner"
    }
  },
  "system_completion": {
    "enabled": true,
    "trigger_key": "ctrl+space",
    "context_window": 2000,
    "max_tokens": 500
  },
  "astrbot": {
    "enabled": true,
    "endpoint": "/v1/astrbot",
    "default_provider": "openai"
  },
  "memory": {
    "enabled": true,
    "storage_path": "/etc/ai-os/memory.json",
    "compress_after": 30,
    "compression_model": "deepseek/deepseek-chat",
    "system_prompt": "你是记忆压缩专家。将以下对话历史压缩为简短摘要，保留所有重要事实、决定、用户偏好和上下文。输出纯JSON格式：{\"summary\":\"...\",\"facts\":[\"...\"],\"preferences\":[\"...\"]}",
    "profile_analysis": {
      "enabled": true,
      "min_daily_messages": 100,
      "analysis_prompt": "你是人物画像分析师。根据以下对话记录，分析每个主要人物的性格、情感倾向、喜好与厌恶。同时分析群聊特征（活跃氛围、话题分布、互动模式等）。输出纯JSON格式：{\"profiles\":{\"<名字>\":{\"personality\":[\"...\"],\"emotions\":{\"dominant\":\"...\",\"trend\":\"...\"},\"likes\":[\"...\"],\"dislikes\":[\"...\"],\"communication_style\":\"...\"}},\"group\":{\"atmosphere\":\"...\",\"topics\":[\"...\"],\"interaction_pattern\":\"...\",\"active_members\":[\"...\"]}}"
    }
  },
  "bot": {
    "tools_enabled": true,
    "autonomous": {
      "enabled": false,
      "schedule": "0 * * * *",
      "default_model": "deepseek/deepseek-chat",
      "system_prompt": "你是系统的 AI 助手。请检查系统状态、日志和重要事件，如有异常及时记录到 /var/log/ai-os-bot.log。用中文简短回复。",
      "task": "检查系统状态并汇报"
    },
    "active": {
      "enabled": false,
      "min_tasks": 3,
      "max_tasks": 8,
      "default_model": "deepseek/deepseek-chat",
      "system_prompt": "你是什亭之匣的 AI 管家，正在自主进行日常活动。当前时间：{time}，日期：{date}。请从可用活动中选择一个，用中文简短说明你的行动。活动包括：检查系统资源、读取日志、查看记忆摘要、运行系统诊断、查看网络状态、整理临时文件、更新系统信息、检查服务状态等。你有权使用工具来完成任务。",
      "activity_pool": ["检查系统资源使用情况", "查看最近的系统日志", "检查 AI 网关和服务状态", "读取今日对话记忆摘要", "查看网络连接状态", "检查磁盘空间和使用情况", "运行系统健康诊断", "整理 /tmp 临时文件", "检查 SSH 登录记录", "查看内存和 CPU 历史趋势", "检查时区和语言设置是否正确", "验证 AI Gateway 配置是否有效"],
      "log_path": "/var/log/ai-os-active.log"
    }
  }
}
